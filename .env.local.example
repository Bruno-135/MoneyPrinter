# ---------------------------------------------------------------------------
# Sistema de Prospeção Comercial — variáveis de ambiente
#
# Copiar para `.env.local` e preencher. `.env.local` NUNCA vai para o git.
# Na Vercel: Project Settings -> Environment Variables (Production/Preview/Development).
# ---------------------------------------------------------------------------

# ===========================================================================
# PÚBLICAS — enviadas para o browser. Não pôr aqui nada que seja segredo.
# ===========================================================================

# URL do projeto Supabase. Supabase -> Project Settings -> Data API.
NEXT_PUBLIC_SUPABASE_URL=""

# Chave publishable. Segura no browser: as políticas de RLS aplicam-se.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# URL base da aplicação. Usada para montar os links públicos das landing pages.
# Local: http://localhost:3000   Produção: https://o-teu-dominio.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ===========================================================================
# PRIVADAS — só servidor. Nunca prefixar com NEXT_PUBLIC_.
# Nunca importar num Client Component.
# ===========================================================================

# Service role key do Supabase. IGNORA a RLS — acesso total à base de dados.
# Só para tarefas de sistema (jobs, webhooks). Se vazar, roda-se já.
SUPABASE_SERVICE_ROLE_KEY=""

# Google Places API. Ativar "Places API (New)" no Google Cloud Console.
# Restringir a chave por IP/serviço — não por HTTP referrer (é usada no servidor).
GOOGLE_PLACES_API_KEY=""

# ===========================================================================
# OPCIONAIS — têm valor por omissão se ficarem vazias.
# ===========================================================================

# Validade por omissão de uma landing page gerada, em dias. Omissão: 30.
PUBLIC_SITE_DEFAULT_TTL_DAYS="30"

# Dias até uma região pesquisada ser considerada velha e valer a pena repetir
# a busca no Google Places. Omissão: 30.
REGION_SEARCH_CACHE_DAYS="30"
